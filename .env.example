# ── Contexte d'application Base44 (OBLIGATOIRE pour les uploads) ──────────
# Sans VITE_BASE44_APP_ID, le SDK construit des URL en `/api/apps/undefined/...`
# et le backend reçoit app_id=None / app_owner=None → l'intégration d'upload
# n'est routée vers aucune application : c'est exactement l'erreur observée
#   "[BUF] malloc failure (_ssl.c:2437) — integration: UploadPublicFile,
#    inputs: {'app_id': None, 'app_owner': None, ...}"
#
# Où trouver votre APP_ID : dans l'URL du Builder
#   https://app.base44.com/apps/<APP_ID>/expert/edit
# ou via la CLI : `base44 link` écrit base44/.app.jsonc ; copiez-en l'app id ici.
VITE_BASE44_APP_ID=
# URL du backend publié de l'app (vide = même origine sur le web ; sinon https://chay.base44.app)
VITE_BASE44_APP_BASE_URL=https://chay.base44.app
# Version des fonctions backend déployées (optionnel, voir dashboard → Functions)
VITE_BASE44_FUNCTIONS_VERSION=
