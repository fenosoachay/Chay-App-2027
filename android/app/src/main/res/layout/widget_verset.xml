<?xml version="1.0" encoding="utf-8"?>
<!-- Widget « Verset du jour » (VersetWidget.java), design « Nuit dorée » : la carte (fond marine-violet, liseré
     doré) et, dessus, une image dessinée par l'app avec les polices du site (Instrument Serif, Poppins). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_verset_racine"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_verset_fond">

    <ImageView
        android:id="@+id/widget_verset_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="Verset du jour"
        android:scaleType="fitCenter"
        android:src="@drawable/widget_verset_apercu" />
</FrameLayout>
