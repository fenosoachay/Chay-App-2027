<?xml version="1.0" encoding="utf-8"?>
<!-- Fond du widget « Verset du jour » (design « Nuit dorée ») : marine vers violet, fin liseré doré. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="0"
        android:startColor="#0C0E2C"
        android:centerColor="#1E1448"
        android:endColor="#2E1A5C"
        android:type="linear" />
    <stroke android:width="1dp" android:color="#8CC9A052" />
    <corners android:radius="24dp" />
</shape>
