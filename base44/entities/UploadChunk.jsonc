{
  "name": "UploadChunk",
  "type": "object",
  "properties": {
    "session_id": {
      "type": "string"
    },
    "index": {
      "type": "number"
    },
    "total": {
      "type": "number"
    },
    "size": {
      "type": "number",
      "description": "Taille du morceau en octets (buf.byteLength \u00e0 la r\u00e9ception)."
    },
    "sha256": {
      "type": "string",
      "description": "Empreinte SHA-256 du morceau (int\u00e9grit\u00e9)."
    },
    "file_uri": {
      "type": "string"
    },
    "created_by": {
      "type": "string"
    }
  },
  "required": [
    "session_id",
    "index"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}