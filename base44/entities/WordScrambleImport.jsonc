{
  "name": "WordScrambleImport",
  "type": "object",
  "properties": {
    "file_name": {
      "type": "string",
      "description": "Nom du fichier JSON import\u00e9."
    },
    "word_count": {
      "type": "number",
      "description": "Nombre de mots import\u00e9s depuis ce fichier."
    },
    "skipped_count": {
      "type": "number",
      "description": "Nombre de mots ignor\u00e9s car invalides."
    },
    "category_values": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Cat\u00e9gories cr\u00e9\u00e9es par cet import."
    },
    "status": {
      "type": "string",
      "enum": [
        "processing",
        "complete",
        "failed"
      ],
      "description": "\u00c9tat de l'import."
    },
    "error": {
      "type": "string",
      "description": "Erreur rencontr\u00e9e pendant l'import, le cas \u00e9ch\u00e9ant."
    }
  },
  "required": [
    "file_name",
    "status"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
