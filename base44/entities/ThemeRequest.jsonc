{
  "name": "ThemeRequest",
  "type": "object",
  "description": "Demande de thème à expliquer adressée aux admins désignés (hors créateur de l'application).",
  "properties": {
    "user_id": { "type": "string", "description": "Compte du demandeur." },
    "theme": { "type": "string", "description": "Thème proposé (500 caractères max)." },
    "passage": { "type": "string", "description": "Passage biblique facultatif." },
    "status": { "type": "string", "enum": ["pending", "validated", "declined"], "default": "pending" },
    "admin_note": { "type": "string", "description": "Note facultative laissée par l'admin qui traite la demande." },
    "handled_by": { "type": "string", "description": "Compte de l'admin qui a traité la demande." },
    "handled_date": { "type": "string", "format": "date-time" }
  },
  "required": ["user_id", "theme"],
  "rls": {
    "read": {
      "$or": [
        { "data.user_id": "{{user.id}}" },
        {
          "$and": [
            { "user_condition": { "role": "admin" } },
            {
              "$not": {
                "entity_query": {
                  "entity": "User",
                  "filter_by": { "role": "admin" },
                  "sort_by": "created_date",
                  "limit": 1,
                  "condition": { "id": "{{user.id}}" }
                }
              }
            }
          ]
        }
      ]
    },
    "create": { "auth": true },
    "update": {
      "$or": [
        {
          "$and": [
            { "user_condition": { "role": "admin" } },
            {
              "$not": {
                "entity_query": {
                  "entity": "User",
                  "filter_by": { "role": "admin" },
                  "sort_by": "created_date",
                  "limit": 1,
                  "condition": { "id": "{{user.id}}" }
                }
              }
            }
          ]
        },
        {
          "$and": [
            { "data.user_id": "{{user.id}}" },
            { "data.status": "pending" }
          ]
        }
      ]
    },
    "delete": {
      "$and": [
        { "user_condition": { "role": "admin" } },
        {
          "$not": {
            "entity_query": {
              "entity": "User",
              "filter_by": { "role": "admin" },
              "sort_by": "created_date",
              "limit": 1,
              "condition": { "id": "{{user.id}}" }
            }
          }
        }
      ]
    }
  }
}
