{
  "name": "MemberProfile",
  "type": "object",
  "properties": {
    "display_name": {
      "type": "string"
    },
    "avatar_url": {
      "type": "string"
    },
    "cover_url": {
      "type": "string",
      "description": "Photo de couverture publique du membre."
    },
    "bio": {
      "type": "string",
      "description": "Biographie publique du membre."
    },
    "last_seen_at": {
      "type": "string"
    },
    "active_conversation_id": {
      "type": "string",
      "description": "Conversation actuellement ouverte par l'utilisateur (signal anti-notification en temps r\u00e9el)."
    }
  },
  "required": [
    "display_name"
  ],
  "rls": {
    "read": {},
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}