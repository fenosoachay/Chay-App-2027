{
  "name": "WordScrambleHistory",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "word_id": {
      "type": "string"
    },
    "session_id": {
      "type": "string"
    },
    "difficulty": {
      "type": "string",
      "enum": [
        "easy",
        "medium",
        "hard",
        "ultra_hard"
      ]
    },
    "score_earned": {
      "type": "number",
      "default": 0
    },
    "hints_used": {
      "type": "number",
      "default": 0
    },
    "solved": {
      "type": "boolean"
    },
    "played_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "user_id",
    "word_id",
    "difficulty"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}