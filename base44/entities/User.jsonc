{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "description": "The role of the user in the app",
      "enum": [
        "admin",
        "user",
        "moderator"
      ]
    },
    "first_name": {
      "type": "string"
    },
    "last_name": {
      "type": "string"
    },
    "gender": {
      "type": "string",
      "enum": [
        "Homme",
        "Femme"
      ]
    },
    "phone": {
      "type": "string"
    },
    "country": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "profile_photo_url": {
      "type": "string"
    },
    "cover_photo_url": {
      "type": "string",
      "description": "Photo de couverture affich\u00e9e en haut de la page de profil du membre."
    },
    "profile_bio": {
      "type": "string",
      "description": "Courte biographie publique affich\u00e9e sur la page de profil du membre. Distincte de la biographie priv\u00e9e du parcours spirituel."
    },
    "location_lat": {
      "type": "number"
    },
    "location_lng": {
      "type": "number"
    },
    "location_label": {
      "type": "string"
    },
    "localisation_activee": {
      "type": "boolean"
    },
    "birth_date": {
      "type": "string",
      "format": "date"
    },
    "birth_place": {
      "type": "string"
    },
    "conversion_date": {
      "type": "string",
      "format": "date"
    },
    "baptized": {
      "type": "boolean"
    },
    "baptism_date": {
      "type": "string",
      "format": "date"
    },
    "church": {
      "type": "string"
    },
    "bio": {
      "type": "string"
    },
    "spiritual_journey": {
      "type": "string"
    },
    "known_chay_since": {
      "type": "string"
    },
    "accepte_commentaires_respect": {
      "type": "boolean"
    },
    "accepte_cookies": {
      "type": "boolean"
    },
    "accepte_cgu": {
      "type": "boolean"
    },
    "consents_accepted": {
      "type": "boolean"
    },
    "church_assigned": {
      "type": "string"
    },
    "bible_last_book": {
      "type": "string"
    },
    "bible_last_chapter": {
      "type": "number"
    },
    "settings": {
      "type": "object",
      "additionalProperties": true,
      "description": "Pr\u00e9f\u00e9rences de l'utilisateur (affichage, notifications, confidentialit\u00e9) \u2014 persist\u00e9es sur le compte."
    },
    "youtube_prefs": {
      "type": "object",
      "additionalProperties": true,
      "description": "Pr\u00e9f\u00e9rences YouTube : ordre des playlists, cadenas et mode al\u00e9atoire par cat\u00e9gorie."
    },
    "in_app_messages": {
      "type": "boolean",
      "default": true,
      "description": "Recevoir les notifications in-app pour les nouveaux messages priv\u00e9s."
    },
    "in_app_nouveautes": {
      "type": "boolean",
      "default": true,
      "description": "Recevoir les notifications in-app pour les nouveaut\u00e9s publi\u00e9es par l'admin."
    },
    "email_messages": {
      "type": "boolean",
      "default": true,
      "description": "Recevoir un e-mail pour les nouveaux messages priv\u00e9s."
    },
    "email_nouveautes": {
      "type": "boolean",
      "default": true,
      "description": "Recevoir un e-mail pour les nouveaut\u00e9s publi\u00e9es par l'admin."
    },
    "admin_email_nouveautes": {
      "type": "boolean",
      "default": true,
      "description": "R\u00e9glage admin : activer l'envoi d'e-mails de nouveaut\u00e9s en masse lors d'une publication."
    },
    "is_membre": {
      "type": "boolean",
      "default": false,
      "description": "Membre de l'\u00e9glise (d\u00e9faut: false). Modifi\u00e9 manuellement par un admin."
    }
  },
  "required": [
    "role"
  ]
}