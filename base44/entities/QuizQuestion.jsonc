{
  "name": "QuizQuestion",
  "type": "object",
  "properties": {
    "question": {
      "type": "string",
      "description": "Texte de la question"
    },
    "option_a": {
      "type": "string"
    },
    "option_b": {
      "type": "string"
    },
    "option_c": {
      "type": "string"
    },
    "option_d": {
      "type": "string"
    },
    "correct_answer": {
      "type": "string",
      "enum": [
        "A",
        "B",
        "C",
        "D"
      ],
      "description": "Bonne r\u00e9ponse. Jamais envoy\u00e9e au joueur."
    },
    "difficulty": {
      "type": "string",
      "enum": [
        "easy",
        "medium",
        "hard"
      ]
    },
    "category": {
      "type": "string",
      "description": "ex : ancien_testament, jesus, prophetes"
    },
    "explanation": {
      "type": "string",
      "description": "Explication affich\u00e9e apr\u00e8s la r\u00e9ponse"
    }
  },
  "required": [
    "question",
    "option_a",
    "option_b",
    "option_c",
    "option_d",
    "correct_answer",
    "difficulty"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}