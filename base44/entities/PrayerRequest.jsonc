{
  "name": "PrayerRequest",
  "type": "object",
  "description": "Demande de prière anonyme. requester_id et taken_by ne sont jamais lisibles par autrui : les autres utilisateurs ne voient que les prières ouvertes, en anonymat complet.",
  "properties": {
    "requester_id": { "type": "string", "description": "Compte du demandeur — privé, jamais exposé aux autres utilisateurs." },
    "category": { "type": "string", "enum": ["Santé", "Famille", "Travail", "Guidance", "Autre"] },
    "content": { "type": "string", "description": "Sujet de prière (300 caractères max)." },
    "status": { "type": "string", "enum": ["open", "taken", "answered"], "default": "open" },
    "taken_by": { "type": "string", "description": "Compte de l'intercesseur — privé, jamais exposé (même au demandeur)." },
    "taken_date": { "type": "string", "format": "date-time" },
    "answered_date": { "type": "string", "format": "date-time" }
  },
  "required": ["requester_id", "category", "content"],
  "rls": {
    "read": {
      "$or": [
        { "data.requester_id": "{{user.id}}" },
        { "data.taken_by": "{{user.id}}" },
        { "data.status": "open" }
      ]
    },
    "create": { "auth": true },
    "update": {
      "$or": [
        { "data.requester_id": "{{user.id}}" },
        { "data.taken_by": "{{user.id}}" }
      ]
    },
    "delete": { "user_condition": { "role": "admin" } }
  }
}
