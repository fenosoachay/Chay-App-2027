{
  "name": "YouTubeVideo",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "youtube_id": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "thumbnail_url": {
      "type": "string"
    },
    "cover_url": {
      "type": "string"
    },
    "verse_note": {
      "type": "string"
    },
    "section": {
      "type": "string",
      "enum": [
        "culte",
        "louange"
      ],
      "default": "culte"
    }
  },
  "required": [
    "title",
    "youtube_id"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}