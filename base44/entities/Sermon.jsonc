{
  "name": "Sermon",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "speaker": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "duration_minutes": {
      "type": "number"
    },
    "category": {
      "type": "string"
    },
    "language": {
      "type": "string",
      "enum": [
        "fr",
        "en",
        "mg"
      ],
      "default": "fr"
    },
    "cover_url": {
      "type": "string"
    },
    "audio_url": {
      "type": "string"
    },
    "bible_references": {
      "type": "string"
    },
    "visibility": {
      "type": "string",
      "enum": [
        "membre",
        "non-membre"
      ],
      "description": "Qui peut voir ce contenu"
    },
    "created_by_admin": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "title",
    "speaker",
    "date",
    "visibility"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}