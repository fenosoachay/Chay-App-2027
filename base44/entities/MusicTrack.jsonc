{
  "name": "MusicTrack",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "artist": {
      "type": "string"
    },
    "album": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "language": {
      "type": "string",
      "enum": [
        "fr",
        "en",
        "mg"
      ],
      "default": "fr"
    },
    "cover_url": {
      "type": "string"
    },
    "audio_url": {
      "type": "string"
    },
    "duration_seconds": {
      "type": "number"
    },
    "visibility": {
      "type": "string",
      "enum": [
        "membre",
        "non-membre"
      ],
      "description": "Qui peut voir ce contenu"
    },
    "created_by_admin": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "title",
    "artist",
    "visibility"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}