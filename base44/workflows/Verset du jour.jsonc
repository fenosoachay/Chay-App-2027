{
  "description": "Chaque jour \u00e0 07:00 (Europe/Paris) : envoie le verset du jour aux utilisateurs abonn\u00e9s (heure demand\u00e9e \u2264 07:00, jour coch\u00e9) \u2014 notification in-app + push Android + push navigateur.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 7 * * *",
      "one_time_date": null,
      "timezone": "Europe/Paris",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "verset_du_jour",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "notify_verse": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "notifyDailyVerse",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Verset du jour",
            "description": "Envoie le verset du jour aux utilisateurs abonn\u00e9s"
          }
        }
      }
    ]
  },
  "name": "Verset du jour"
}